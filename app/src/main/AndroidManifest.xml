<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required to programmatically answer and reject screened calls -->
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Adjust routing/volume without grabbing global transient audio focus -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Capture caller audio for on-device STT -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".AiCallScreeningApplication"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher_foreground"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AiCallScreening"
        tools:targetApi="34">

        <!--
            CallScreeningService must be exported and protected with BIND_CALL_SCREENING_SERVICE
            so only the Telecom framework can bind. User must grant the Call Screening role.
        -->
        <service
            android:name=".service.LocalCallScreeningService"
            android:exported="true"
            android:permission="android.permission.BIND_CALL_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

        <activity
            android:name=".ui.CallLogActivity"
            android:exported="true"
            android:theme="@style/Theme.AiCallScreening">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
